<theme>
  <formatVersion>6</formatVersion><resolution>768 1024</resolution>
  <variables><font>./assets/DejaVuSans.ttf</font><fontBold>./assets/DejaVuSans-Bold.ttf</fontBold><cyan>35f5ff</cyan><pink>ff35cf</pink><gold>ffe35a</gold><white>ffffff</white><muted>b7b8dc</muted></variables>
  <view name="system">
    <image name="background" extra="true"><path>./assets/background-v2.jpg</path><size>768 1024</size><pos>0 0</pos><origin>0 0</origin><zIndex>0</zIndex></image>
    <text name="brand" extra="true"><text>DREADWIRE</text><fontPath>${fontBold}</fontPath><fontSize>68</fontSize><color>${cyan}</color><pos>24 34</pos><size>720 86</size><alignment>center</alignment><zIndex>5</zIndex></text>
    <text name="sub" extra="true"><text>O V E R D R I V E   M A X</text><fontPath>${fontBold}</fontPath><fontSize>21</fontSize><color>${pink}</color><pos>50 122</pos><size>668 36</size><alignment>center</alignment><zIndex>5</zIndex></text>
    <carousel name="systemcarousel"><type>vertical</type><size>570 420</size><pos>99 300</pos><logoSize>450 94</logoSize><logoScale>1.16</logoScale><maxLogoCount>3</maxLogoCount><logoRotation>0</logoRotation><logoRotationOrigin>0.5 0.5</logoRotationOrigin><color>080014d9</color><zIndex>7</zIndex></carousel>
    <text name="logoText"><fontPath>${fontBold}</fontPath><fontSize>31</fontSize><forceUppercase>true</forceUppercase><color>${white}</color><alignment>center</alignment></text>
    <text name="systemInfo"><fontPath>${fontBold}</fontPath><fontSize>23</fontSize><color>${gold}</color><alignment>center</alignment><size>680 48</size><pos>44 746</pos><zIndex>9</zIndex></text>
    <text name="launch" extra="true"><text>▲  CHOOSE YOUR UNIVERSE  ▼</text><fontPath>${fontBold}</fontPath><fontSize>19</fontSize><color>${cyan}</color><pos>44 842</pos><size>680 40</size><alignment>center</alignment><zIndex>9</zIndex></text>
    <helpsystem name="help"><pos>42 954</pos><textColor>${white}</textColor><iconColor>${pink}</iconColor><fontPath>${fontBold}</fontPath><fontSize>20</fontSize></helpsystem>
  </view>
  <view name="basic, detailed, video, grid"><image name="background" extra="true"><path>./assets/background-v2.jpg</path><size>768 1024</size><pos>0 0</pos><origin>0 0</origin><zIndex>0</zIndex></image><image name="logo"><maxSize>310 78</maxSize><pos>384 68</pos><origin>0.5 0.5</origin><zIndex>7</zIndex></image><text name="logoText"><fontPath>${fontBold}</fontPath><fontSize>38</fontSize><forceUppercase>true</forceUppercase><size>700 64</size><pos>34 36</pos><alignment>center</alignment><color>${cyan}</color><zIndex>7</zIndex></text><helpsystem name="help"><pos>38 968</pos><textColor>${white}</textColor><iconColor>${pink}</iconColor><fontPath>${fontBold}</fontPath><fontSize>18</fontSize></helpsystem></view>
  <view name="basic, detailed, video"><textlist name="gamelist"><fontPath>${fontBold}</fontPath><fontSize>29</fontSize><size>690 280</size><pos>39 660</pos><alignment>center</alignment><horizontalMargin>18</horizontalMargin><selectorColor>ff35cf55</selectorColor><selectedColor>${gold}</selectedColor><primaryColor>${white}</primaryColor><secondaryColor>${muted}</secondaryColor><zIndex>9</zIndex></textlist></view>
  <view name="detailed"><image name="md_image"><maxSize>670 490</maxSize><pos>384 372</pos><origin>0.5 0.5</origin><zIndex>8</zIndex></image></view>
  <view name="video"><video name="md_video"><maxSize>670 490</maxSize><pos>384 372</pos><origin>0.5 0.5</origin><delay>0.8</delay><showSnapshotNoVideo>true</showSnapshotNoVideo><zIndex>8</zIndex></video></view>
  <view name="grid"><imagegrid name="gamegrid"><size>710 820</size><pos>29 124</pos><margin>10 12</margin><scrollDirection>vertical</scrollDirection><animate>true</animate><zIndex>8</zIndex></imagegrid><gridtile name="default"><size>218 268</size><padding>9 9</padding><backgroundColor>160024dd</backgroundColor></gridtile><gridtile name="selected"><size>250 310</size><padding>4 4</padding><backgroundColor>ff35cfdd</backgroundColor></gridtile></view>
</theme>
