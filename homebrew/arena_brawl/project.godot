; Standalone portrait cabinet build of Dreadwire Crew: Arena Brawl
config_version=5

[application]
config/name="Dreadwire Crew: Arena Brawl"
run/main_scene="res://arcade/twin_stick/scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.6")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.01, 0.015, 0.04, 1)

[display]
window/size/viewport_width=768
window/size/viewport_height=1024
window/size/window_width_override=768
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
