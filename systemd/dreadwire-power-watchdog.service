[Unit]
Description=Dreadwire learned battery runtime and safe shutdown watchdog
After=dreadwire-companion.service
Wants=dreadwire-companion.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/dreadwire-power-watchdog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
